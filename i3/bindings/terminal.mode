################################################################################
# terminal selector mode

set $mode_terminal (a)lacritty (k)itty (t)erminator (u)rxvt
mode "$mode_terminal" {
    bindsym k exec kitty, mode "default"
    bindsym a exec alacritty, mode "default"
    bindsym u exec urxvt, mode "default"
    bindsym t exec terminator, mode "default"

    # back to normal: Enter or Escape
    bindsym $mod+Ctrl+Return mode "default"
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+Ctrl+Return mode "$mode_terminal"
