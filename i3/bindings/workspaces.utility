# swap out screens
bindsym $mod+$key_rotate exec ~/auto-setup/i3/i3swapvisiblews.sh

# switch to next/previous
bindsym $mod+$key_prev workspace prev
bindsym $mod+$key_next workspace next

# move to next/previous
bindsym $mod+Shift+$key_prev move container to workspace prev
bindsym $mod+Shift+$key_next move container to workspace next

#scratchpad
bindsym $mod+$key_scratchpad scratchpad show
bindsym $mod+Shift+$key_scratchpad move scratchpad
