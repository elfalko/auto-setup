# Read `man 5 sway` for a complete reference.


# Cheat sheet
#
# key   +mod   	    +mod+shift  +mod+ctrl   +mod+shift+ctl  +nothing (only if key itself was overwritten)
#
# q     layout 	    kill window -           -               -
# w     -           -           -           -
# e     -           -           -           -               -
# r     -      	    reload wm   -           -               -
# t     vm          <local vm>  virtualbox  -               -
#
# y     windows	    mv windows  -           -               -
# u     downloads   -           -           -
# i     vscode      nm-editor   -           -               -
# o     quadfox	    -           -           -               -
# p     prev ws     -           -           -               -
#
# a     parent 	    child       -           -               -
# s     -     	    -           -           -               -
# d     -           -           -           -               -
# f     focus       tgl float   -           -               -
# g     -           -           -           -               -
#
# h     focus ᐸ     mv ᐸ        resize ᐸ    -
# j     focus ᐯ     mv ᐯ        resize ᐯ    -
# k     focus ᐱ     mv ᐱ        resize ᐱ    -
# l     focus ᐳ     mv ᐳ        resize ᐳ    -
# ;     -           -           -           -
#
# z     fullscreen  -           -           -
# x     waybar      -           -           -
# c     screenshot  see shots   -           -
# v     scratch     mv scratch  -           -
# b     bluetooth   exit wm     -           -

# n     next ws     -           -           -
# m     mail        -           -           -
# ,     -           -           -           -
# .     -           -           -           -
#
# 1-10  ws switch   mv window   resize win  mv ws to output
# `     [         com ws        ]           k
#
# space app launcher-           -           -
# enter terminal    browser     -           -
# esc   -           -           -           -
# mute  pavuctl     -           -           -
# Print -           -           -           -               screenkey
################################################################################

### Variables
# Logo key. Use Mod1 for Alt.
set $mod Mod3
# Home row direction keys, like vim
set $key_left  h
set $key_down  j
set $key_up    k
set $key_right l

set $key_next  n
set $key_prev  p

set $key_window_hierarchy a

set $key_scratchpad v
set $key_sticky     s

set $key_rotate     r
set $key_reload     r

set $key_quit       q
set $key_lock  escape

set $key_browser    i

set $key_fullscreen f
set $key_float      f

set $key_music      g
set $key_bt         b
set $key_clipboard  g

set $key_files      u

set $key_screenshot c

set $key_bg         z
set $key_monitor    m

set $key_vm         t
set $key_vnc        equal
set $key_connect    semicolon

set $key_3dp        p
set $key_comms      grave

set $key_play_pause F1
set $key_vol_down   F2
set $key_vol_up     F3
set $key_vol_mute   F4

set $key_light_up   F5
set $key_light_down F6

# only used for single screen, otherwise this is comms
set $key_mail       n
set $key_vm_ws      y

# set $key_hints      comma

set $cmd_reload     reload

# fallback on x-terminal-emulator if there is no alacritty
include ../i3/bindings/basics

# start notification first
exec mako --default-timeout=5000 --padding=2 --margin=2 || swaynag -t warning -m 'mako could not start'

set $code code
set $mail thunderbird

include lock.config

set $cmd_balance_ws_fill  /bin/bash ~/auto-setup/sway/focus_free_ws.sh
set $custom_launcher      dmenu_path | dmenu | xargs swaymsg exec --

### Output configuration
# Default wallpaper in /usr/share/backgrounds/
# output eDP-1 position 0 1080 bg /usr/share/backgrounds/mag_Topshot_final.jpg fill

# output $o-left  position 0    0 bg $bg-left  fill
# output $o-right position 1920 0 bg $bg-right fill

# You can get the names of your outputs by running: swaymsg -t get_outputs

include input.config
include ../i3/bindings/screencapture 

### Key bindings

# Exit sway (logs you out of your Wayland session)
bindsym $mod+Shift+e exec swaynag -t warning -m 'Okay, the test is over now. You win. Go back. For your cake 🎂!' -b 'Yes, exit sway' 'swaymsg exit'

include ../i3/bindings/windownavigation
include ../i3/bindings/layout

exec_always /bin/bash ~/auto-setup/i3/i3-multihead.sh --path ~/.config/i3-multihead/i3-multihead generate "1 2 3 4 5 6 7 8 9 0";
include ~/.config/i3-multihead/i3-multihead.config
exec_always /bin/bash ~/auto-setup/i3/i3-multihead.sh expand

# Layout stuff:
# Drag floating windows by holding down $mod+left mouse button.
# Resize them with $mod+right mouse button
# Despite the name, also works for non-floating windows.
# normal/inverse: flip buttons
floating_modifier $mod normal
workspace_auto_back_and_forth no

hide_edge_borders smart
default_border pixel 1
default_floating_border pixel 1
focus_follows_mouse yes
focus_on_window_activation smart

include bindings/mediakeys
include bindings/workspaces.utility

# bar config
include ~/auto-setup/sway/status-config

exec_always autotiling
exec nm-applet

include ../i3/bindings/virtualbox

include machine.secondchance
