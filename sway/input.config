### Input configuration

# input "2:7:SynPS/2_Synaptics_TouchPad" {
#     dwt enabled
#     tap enabled
#     natural_scroll enabled
#     middle_emulation enabled
# }

# swaymsg -t get_inputs
# Read `man 5 sway-input`.

# https://github.com/francma/wob

#https://wiki.archlinux.org/title/Sway#Graphical_indicator_bars

#also xkeyboard-config(7) l. 1100+ and sway-input(5)
input * {
    xkb_layout "custom"
    # TODO add `compose:<key>`
    xkb_options "terminate:ctrl_alt_bksp,caps:none"
    xkb_numlock enable
}

# seat seat0 xcursor_theme Nordzy-cursors 48
exec wl-paste -t text --watch clipman store --no-persist || notify-send "wl-clipboard not found"
bindsym $mod+$key_clipboard exec clipman pick --tool=dmenu || notify-send "clipman not found"
